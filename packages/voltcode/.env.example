# Volt local environment example
#
# Copy this file to packages/voltcode/.env and adjust as needed.
# Keep exactly one LCM profile active at a time (Dolt or Upward).
#
# Provider credentials (set the one(s) you use):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MINIMAX_API_KEY=
# HF_TOKEN=
#
# Optional local config override directory:
# VOLTCODE_CONFIG_DIR=/absolute/path/to/packages/voltcode/.voltcode-local
#
# Optional external Postgres (otherwise embedded Postgres is used):
# LCM_DATABASE_URL=postgres://voltcode@127.0.0.1:5432/voltcode_lcm

# ------------------------------------------------------------------
# Shared runtime controls (defaults)
# ------------------------------------------------------------------
VOLTCODE_LCM_DEFAULT_CTX_CUTOFF_THRESHOLD=0.6
VOLTCODE_LCM_TARGET_FREE_PERCENTAGE=0.25
VOLTCODE_LCM_MIN_MESSAGES_TO_SUMMARIZE=3
VOLTCODE_LCM_MIN_PROTECTED_TAIL_LEAVES=2
VOLTCODE_LCM_CRITICAL_THRESHOLD_MULTIPLIER=1.2
VOLTCODE_LCM_MAX_COMPACTION_ROUNDS=10
VOLTCODE_LCM_SUMMARY_MAX_OUTPUT_TOKENS=2200
VOLTCODE_LCM_CONDENSE_MAX_OUTPUT_TOKENS=2200

# ------------------------------------------------------------------
# Profile A: Dolt (example; commented out)
# ------------------------------------------------------------------
# VOLTCODE_LCM_MODE=dolt
#
# VOLTCODE_LCM_DOLT_LEAVES_SOFT=50000
# VOLTCODE_LCM_DOLT_LEAVES_DELTA=5000
# VOLTCODE_LCM_DOLT_LEAVES_TARGET=50000
# VOLTCODE_LCM_DOLT_LEAVES_MIN_FANOUT=2
# VOLTCODE_LCM_DOLT_LEAVES_CAP=50000
# VOLTCODE_LCM_DOLT_LEAVES_FRESH_TAIL_FLOOR=4
#
# VOLTCODE_LCM_DOLT_SPRIGS_SOFT=10000
# VOLTCODE_LCM_DOLT_SPRIGS_DELTA=2000
# VOLTCODE_LCM_DOLT_SPRIGS_TARGET=10000
# VOLTCODE_LCM_DOLT_SPRIGS_MIN_FANOUT=2
#
# VOLTCODE_LCM_DOLT_BINDLES_SOFT=10000
# VOLTCODE_LCM_DOLT_BINDLES_DELTA=2000
# VOLTCODE_LCM_DOLT_BINDLES_TARGET=10000
# VOLTCODE_LCM_DOLT_BINDLES_MIN_FANOUT=2
#
# VOLTCODE_LCM_DOLT_HARD_LIMIT_RISK_BUFFER=0
# VOLTCODE_LCM_DOLT_GHOST_CUE_ARCHIVE_ENABLED=true
#
# VOLTCODE_LCM_RETRIEVAL_QMD_INDEX_PREFIX=voltcode-lcm-retrieval
# VOLTCODE_LCM_RETRIEVAL_QMD_COLLECTION_NAME=off-context-bindles
# VOLTCODE_LCM_RETRIEVAL_TOP_K=3
# VOLTCODE_LCM_RETRIEVAL_MIN_SCORE=0.3
# VOLTCODE_LCM_PRE_RESPONSE_HOOK_TOP_K=3
# VOLTCODE_LCM_PRE_RESPONSE_HOOK_MIN_SCORE=0.3

# ------------------------------------------------------------------
# Profile B: Upward (active defaults)
# ------------------------------------------------------------------
VOLTCODE_LCM_MODE=upward
VOLTCODE_LCM_UPWARD_CONTEXT_THRESHOLD=0.75
VOLTCODE_LCM_UPWARD_FRESH_TAIL_COUNT=32
VOLTCODE_LCM_UPWARD_LEAF_CHUNK_TOKENS=20000
VOLTCODE_LCM_UPWARD_LEAF_MIN_FANOUT=8
VOLTCODE_LCM_UPWARD_CONDENSED_MIN_FANOUT=4
VOLTCODE_LCM_UPWARD_CONDENSED_MIN_FANOUT_HARD=2
VOLTCODE_LCM_UPWARD_CONDENSED_TARGET_TOKENS=2000
